# RCV Thoth — environment template.
# install.sh generates a real .env with strong random secrets. Never commit a
# filled-in .env.

# Image tag to pull. `latest` tracks the most recent release; pin a published
# release for a reproducible install, e.g. THOTH_VERSION=0.1.0
THOTH_VERSION=latest

# Host port to publish. The container always listens on 3000.
THOTH_PORT=3000

# --- Required ---------------------------------------------------------------

# Public URL people reach the app at. MUST be https:// — the server refuses to
# start on an http:// URL rather than serve anything in the clear. SSO redirect
# URIs and the links in invitation, password-reset and digest mail are built
# from this value, so it must match the externally reachable URL.
BASE_URL=https://contacts.example.com

# --- Recommended ------------------------------------------------------------

# Cookie signing key. Generate with: openssl rand -hex 32
# Leave empty and the app generates one into the data volume and reuses it —
# fine for a single instance, but setting it explicitly means restoring the
# volume elsewhere does not sign everyone out.
SESSION_SECRET=

# First administrator, created at startup only while no users exist. Leave
# ADMIN_EMAIL empty to use the setup page on first visit instead. Remove both
# once the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- TLS --------------------------------------------------------------------

# Thoth terminates TLS itself. With no certificate configured it generates a
# self-signed one into the data volume covering localhost, 127.0.0.1, the
# BASE_URL host and TLS_SELF_SIGNED_HOSTS, and reuses it until 30 days before
# it expires. Traffic is encrypted either way; browsers warn once on a
# self-signed certificate.

# Your own certificate (PEM). Mount the files into the container — see the
# commented ./certs volume in docker-compose.yml.
TLS_CERT=
TLS_KEY=

# Extra hostnames / IPs to put in the generated certificate, comma separated.
TLS_SELF_SIGNED_HOSTS=

# "true" ONLY behind a reverse proxy that terminates TLS and sets
# X-Forwarded-Proto (Caddy, Traefik, nginx). The proxy may speak plain HTTP or
# HTTPS to the app; requests that were not HTTPS at the edge are redirected.
# Setting this without such a proxy in front means trusting a header any client
# can forge.
TRUST_PROXY=false

# --- Options ----------------------------------------------------------------

# How often subscribed external calendars are refreshed, in minutes.
CALENDAR_SYNC_MINUTES=30

# Everything else — branding, work mode, SSO providers and their secrets, SMTP,
# roles, portal links — is configured in Settings by an administrator and stored
# in the database. There are no environment variables for those, by design.
